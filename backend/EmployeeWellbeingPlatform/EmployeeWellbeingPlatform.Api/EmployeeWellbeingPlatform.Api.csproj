<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9124a706-b21c-4ddb-b34c-3451fd661971</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Extensions\**" />
    <Compile Remove="Middlewares\**" />
    <Content Remove="Extensions\**" />
    <Content Remove="Middlewares\**" />
    <EmbeddedResource Remove="Extensions\**" />
    <EmbeddedResource Remove="Middlewares\**" />
    <None Remove="Extensions\**" />
    <None Remove="Middlewares\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.16" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.16">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="QuestPDF" Version="2026.6.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmployeeWellbeingPlatform.Application\EmployeeWellbeingPlatform.Application.csproj" />
    <ProjectReference Include="..\EmployeeWellbeingPlatform.Infrastructure\EmployeeWellbeingPlatform.Infrastructure.csproj" />
  </ItemGroup>

</Project>
